# ============================================================
#  LibreriaBrend - Reglas de exclusión
#  Añadido en la Fase 2 de la auditoría (rama audit/fase-2-runtime).
# ============================================================

# --- Artefactos de compilación ---
target/
build/
out/
.tools/
.tools-libreria/
*.class
*.war
*.ear

# --- Logs y volcados del contenedor ---
*.log
logs/
catalina.out
localhost.*.log
hs_err_pid*.log
*.hprof
# Excepción: la evidencia textual de la auditoría vive en evidencias/logs/
!docs/auditoria/evidencias/logs/
!docs/auditoria/evidencias/logs/**

# --- Configuración local con credenciales ---
# La plantilla db.properties.example SÍ se versiona; las credenciales reales no.
WebContent/WEB-INF/db.properties
*.properties
!docs/**/*.properties
*.env
.env
.env.*
context.xml
!docs/**/context.xml
*.jks
*.keystore
*.p12

# --- Volcados de base de datos (pueden contener datos personales) ---
*.sql.gz
*.dump
*.sql.bak
dump*.sql
!docs/**/*.sql

# --- Entornos de desarrollo (decisión pendiente del equipo) ---
# .settings/
# .classpath
# .project

# --- Entregables de la Práctica 12: pruebas estáticas ---
# El informe Word del laboratorio y la evidencia de métricas son artefactos
# de entrega académica, no parte del producto: no se versionan.
/LABORATORIO*N*12*.docx
/analisis-estatico-lab12/

# --- Artefactos locales del equipo ---
# .cloud-attachments/ guarda conversaciones importadas que pueden contener
# datos personales del proyecto: nunca se versionan.
.cloud-attachments/
desktop.ini
# Capturas de pantalla pendientes de revisión antes de publicarlas
/screenshots/
# Datos binarios de cobertura JaCoCo (los reportes CSV/XML/HTML sí se versionan)
*.exec
